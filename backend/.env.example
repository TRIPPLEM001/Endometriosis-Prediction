# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (used by Docker Compose) ---
POSTGRES_USER=endo_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=endo_screening

# --- Auth ---
# Required, at least 32 characters (the app refuses to start otherwise).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Keep false until the models are validated on real clinical data.
# While false, results are labelled as a prototype and wording is softened.
MODEL_VALIDATED=false

# --- Only needed when running uvicorn outside Docker (Compose builds this itself) ---
# DATABASE_URL=postgresql+psycopg://endo_app:change-me@localhost:5432/endo_screening
